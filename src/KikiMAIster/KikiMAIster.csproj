<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KikiMAIster</AssemblyName>
    <Version>0.18.0</Version>
    <RootNamespace>KikiMAIster</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Game branch to build against: beta (default) or default -->
    <GameBranch Condition="'$(GameBranch)' == ''">beta</GameBranch>
    <GameLibDir>$(MSBuildThisFileDirectory)../../lib/$(GameBranch)/</GameLibDir>
    <!-- GAME_BETA / GAME_DEFAULT: the few places where the two game branches differ -->
    <DefineConstants>$(DefineConstants);GAME_$(GameBranch.ToUpperInvariant())</DefineConstants>
    <!-- Development builds: F9 only saves the report (no browser); public builds (-p:PublicRelease=true) open the issue form -->
    <DefineConstants Condition="'$(PublicRelease)' != 'true'">$(DefineConstants);DEV_TOOLS</DefineConstants>
    <!-- Line numbers in error reports, without the build machine's folders (v0.18.0) -->
    <DebugType>embedded</DebugType>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))=/KikiMAIster/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameLibDir)sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameLibDir)0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameLibDir)GodotSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The stats engine is compiled into the mod: one DLL to ship. -->
    <Compile Include="../KikiMAIster.Core/**/*.cs" Exclude="../KikiMAIster.Core/obj/**;../KikiMAIster.Core/bin/**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="KikiMAIster.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckGameLibs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameLibDir)sts2.dll')" Text="Game DLLs not found in $(GameLibDir). Copy them from the Windows install (see README)." />
  </Target>
</Project>
